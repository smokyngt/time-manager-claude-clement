{
  "name": "@time-manager/sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript SDK for the Time Manager API.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./dist": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "bun build src/index.ts --target=browser --format=esm --outdir=dist && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist",
    "lint": "eslint . --max-warnings=0",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@types/bun": "^1.4.2",
    "eslint": "9",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "prettier": "^3.9.9",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.1"
  }
}
