# syntax=docker/dockerfile:1
# Production image for the SPA: bun build -> nginx static serving + API reverse proxy.
# Build context is the repo root (the SDK is imported from sdks/typescript/src):
#   docker build -f web/Dockerfile.prod .

# ---- build ----
FROM oven/bun:1.3 AS build
WORKDIR /repo/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
# The SDK has no runtime dependencies; only its sources are needed (vite alias + tsc paths).
COPY sdks/typescript/ /repo/sdks/typescript/
COPY web/ ./
# Empty = same origin (nginx proxies /v1 to the api service).
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN bun run build

# ---- runtime ----
FROM nginx:1.27-alpine AS runtime
RUN rm -f /etc/nginx/conf.d/default.conf
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/web/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
