# syntax=docker/dockerfile:1
# Build context is the repo root (the SDK is imported from sdks/typescript/src):
#   docker build -f web/Dockerfile.prod .

FROM oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 AS build
WORKDIR /repo/web
COPY web/package.json web/bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --ignore-scripts
COPY sdks/typescript/ /repo/sdks/typescript/
COPY web/ ./
# Empty = same origin (nginx proxies /v1 to the api service).
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN bun run build \
    && mkdir -p /out \
    && bun docker/csp.mjs dist/index.html > /out/csp.conf

FROM nginxinc/nginx-unprivileged:1.30.5-alpine@sha256:15c994d10d6d78658721c3bcafff14cb281fba2a4bdf9d5ba92c416a472516e3 AS runtime
ARG VERSION=0.0.0
ARG REVISION=unknown
ARG SOURCE=https://github.com/smokyngt/time-manager-claude-clement
LABEL org.opencontainers.image.title="time-manager-web" \
      org.opencontainers.image.description="Time Manager SPA served by nginx, reverse proxy to the API" \
      org.opencontainers.image.source="${SOURCE}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.version="${VERSION}"

COPY --chown=0:0 web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chown=0:0 web/nginx/ /etc/nginx/snippets/
COPY --from=build --chown=0:0 /out/csp.conf /etc/nginx/snippets/csp.conf
COPY --from=build --chown=0:0 /repo/web/dist /usr/share/nginx/html

USER 101:101
ENV NGINX_ENTRYPOINT_QUIET_LOGS=1
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "--spider", "http://127.0.0.1:8080/healthz"]
