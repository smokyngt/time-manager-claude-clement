# syntax=docker/dockerfile:1
# Development image. Build context is the repo root (the SDK lives in sdks/typescript).
# Source is bind-mounted by docker-compose.dev.yml: ./web -> /repo/web, ./sdks -> /repo/sdks.
FROM oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895
WORKDIR /repo/web

COPY web/package.json web/bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile --ignore-scripts

COPY sdks/ /repo/sdks/
COPY web/ ./

EXPOSE 5173
CMD ["bun", "run", "dev", "--host", "0.0.0.0"]
