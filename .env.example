# Copy to .env (`cp .env.example .env`) and replace every CHANGE_ME value.
# Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=timemanager
POSTGRES_PASSWORD=timemanager
POSTGRES_DB=timemanager

# --- API ---
NODE_ENV=production
PORT=8000
LOG_LEVEL=info
# Used when running the API outside compose; compose builds its own from POSTGRES_*.
DATABASE_URL=postgres://timemanager:timemanager@db:5432/timemanager

# Required. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_32_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Prod compose serves everything through nginx on :8080 (dev compose uses :5173).
CORS_ORIGIN=http://localhost:8080
WEB_URL=http://localhost:8080

# Refresh cookie `Secure` flag. Keep false for the local http://localhost:8080 stack
# (browsers drop Secure cookies over plain http); set true behind HTTPS.
COOKIE_SECURE=false
# Trusted proxy hops in front of the api (1 = nginx). Wrong values break client IPs and rate limits.
TRUST_PROXY=1
# Allow http/localhost WEB_URL and MICROSOFT_REDIRECT_URI in production mode.
# Local compose only; remove (or set false) behind HTTPS.
ALLOW_INSECURE_URLS=true

# --- Field encryption (required in production; see docs/ENCRYPTION.md) ---
# Generate each with: openssl rand -base64 32   (use different values)
ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_32
HASH_KEY=CHANGE_ME_run_openssl_rand_base64_32
# Id stored with every ciphertext. Bump it (k2, ...) when rotating ENCRYPTION_KEY.
ENCRYPTION_KEY_ID=k1
# Retired keys that stay readable until `make rotate-keys` has re-encrypted everything.
# Format: id:base64[,id:base64]
ENCRYPTION_KEYS_PREVIOUS=

# --- Observability (optional) ---
# Bearer token for GET /metrics. Required by docker-compose.observability.yml.
# Generate with: openssl rand -hex 32
METRICS_TOKEN=
# OTLP/HTTP endpoint for traces. Empty = off; the observability override sets http://alloy:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=time-manager-api
# Reported in telemetry; set to the release tag or commit sha.
APP_VERSION=

# --- Optional API tuning (defaults shown) ---
JSON_BODY_MAX_DEPTH=10
DATABASE_POOL_MAX=10
APP_TIMEZONE=Europe/Paris
USER_RATE_LIMIT_MAX=100
USER_RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW=1 minute
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW=1 minute
AUTH_ACCOUNT_RATE_LIMIT_MAX=5
AUTH_ACCOUNT_RATE_LIMIT_WINDOW=15m

# --- Microsoft SSO (optional) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8080/v1/auth/microsoft/callback
# Required when MICROSOFT_CLIENT_ID is set, 32+ chars, different from the JWT secrets.
# Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=

# --- Admin seed (required: applied automatically on every api start; idempotent) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Dev only (make demo): password of the generated demo users.
DEMO_PASSWORD=demo-password-dev

# --- Web (build time; empty = same origin, nginx proxies /v1) ---
VITE_API_URL=
