# Copy to .env (`cp .env.example .env`) and replace every CHANGE_ME value.
# Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=timemanager
POSTGRES_PASSWORD=timemanager
POSTGRES_DB=timemanager

# --- API ---
NODE_ENV=production
PORT=8000
LOG_LEVEL=info
# Used when running the API outside compose; compose builds its own from POSTGRES_*.
DATABASE_URL=postgres://timemanager:timemanager@db:5432/timemanager

# Required. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_32_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Prod compose serves everything through nginx on :8080 (dev compose uses :5173).
CORS_ORIGIN=http://localhost:8080
WEB_URL=http://localhost:8080

# Refresh cookie `Secure` flag. Keep false for the local http://localhost:8080 stack
# (browsers drop Secure cookies over plain http); set true behind HTTPS.
COOKIE_SECURE=false

# --- Optional API tuning (defaults shown) ---
TRUST_PROXY=true
DATABASE_POOL_MAX=10
APP_TIMEZONE=Europe/Paris
USER_RATE_LIMIT_MAX=100
USER_RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW=1 minute
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW=1 minute

# --- Microsoft SSO (optional) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8080/v1/auth/microsoft/callback

# --- Admin seed (required: applied automatically on every api start; idempotent) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Dev only (make demo): password of the generated demo users.
DEMO_PASSWORD=demo-password-dev

# --- Web (build time; empty = same origin, nginx proxies /v1) ---
VITE_API_URL=
