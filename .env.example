# Copy to .env (`cp .env.example .env`) and replace every CHANGE_ME value.
# Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=timemanager
POSTGRES_PASSWORD=timemanager
POSTGRES_DB=timemanager

# --- API ---
NODE_ENV=production
PORT=8000
LOG_LEVEL=info
# Used when running the API outside compose; compose builds its own from POSTGRES_*.
DATABASE_URL=postgres://timemanager:timemanager@db:5432/timemanager

# Required. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_32_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:5173
WEB_URL=http://localhost:5173

# --- Microsoft SSO (optional) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/v1/auth/microsoft/callback

# --- Seed (make seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Web (build time; empty = same origin, nginx proxies /v1) ---
VITE_API_URL=
