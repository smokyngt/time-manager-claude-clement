# syntax=docker/dockerfile:1
# Production image for the API. Stages: deps -> build -> runtime (prod-deps feeds runtime).
# The runtime image also carries dist/db/{migrate,seed,rotate,purge}.js and drizzle/, so migrations
# and seeding run from the same image (no drizzle-kit needed).

# ---- all dependencies (cached on lockfile only) ----
FROM oven/bun:1.3 AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# ---- build ----
FROM deps AS build
COPY . .
RUN bun run build
# Maintenance entrypoints (key rotation, session purge) -> dist/db/{rotate,purge}.js.
# Redundant once api/package.json's build script lists them; harmless to keep.
RUN bun build src/db/rotate.ts src/db/purge.ts --target=bun --root=src --outdir=dist

# ---- production dependencies only ----
FROM oven/bun:1.3 AS prod-deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

# ---- runtime ----
FROM oven/bun:1.3-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=8000

COPY --from=prod-deps --chown=bun:bun /app/node_modules ./node_modules
COPY --from=build --chown=bun:bun /app/dist ./dist
COPY --from=build --chown=bun:bun /app/drizzle ./drizzle
COPY --chown=bun:bun package.json ./

USER bun
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:'+(process.env.PORT||8000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Migrate + seed (both idempotent), then serve. Overridden by docker-compose.yml.
CMD ["sh", "-c", "bun run db:migrate:prod && bun run db:seed:prod && exec bun run start"]
