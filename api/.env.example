NODE_ENV=development
PORT=8000
LOG_LEVEL=info
DATABASE_URL=postgres://timemanager:timemanager@localhost:5432/timemanager
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173
WEB_URL=http://localhost:5173
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:8000/v1/auth/microsoft/callback
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
MIGRATIONS_DIR=drizzle
USER_RATE_LIMIT_MAX=600
USER_RATE_LIMIT_WINDOW=1 minute
TEAM_RATE_LIMIT_MAX=600
TEAM_RATE_LIMIT_WINDOW=1 minute
TEAM_MEMBER_RATE_LIMIT_MAX=600
TEAM_MEMBER_RATE_LIMIT_WINDOW=1 minute
CLOCK_RATE_LIMIT_MAX=600
CLOCK_RATE_LIMIT_WINDOW=1 minute
REPORT_RATE_LIMIT_MAX=600
REPORT_RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW=1 minute
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW=1 minute
AUTH_ACCOUNT_RATE_LIMIT_MAX=5
AUTH_ACCOUNT_RATE_LIMIT_WINDOW=15m
JSON_BODY_MAX_DEPTH=10

# Hops of trusted proxies (1 = nginx; empty/false = none).
TRUST_PROXY=1
# Refresh cookie Secure flag (defaults to true in production).
COOKIE_SECURE=false
# Production mode only: allow http/localhost WEB_URL and MICROSOFT_REDIRECT_URI.
ALLOW_INSECURE_URLS=false

# Required when MICROSOFT_CLIENT_ID is set. Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=

# Field encryption. Optional in development (keys are derived); required in production.
# Generate each with: openssl rand -base64 32
ENCRYPTION_KEY=
HASH_KEY=
ENCRYPTION_KEY_ID=k1
# Retired keys, readable until re-encrypted with db:rotate. Format: id:base64[,id:base64]
ENCRYPTION_KEYS_PREVIOUS=

# Observability. Generate METRICS_TOKEN with: openssl rand -hex 32
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=time-manager-api
APP_VERSION=
