# syntax=docker/dockerfile:1
# Development image: all dependencies, source is bind-mounted by docker-compose.dev.yml.
FROM oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895
WORKDIR /app

COPY package.json bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile --ignore-scripts

COPY . .

ENV NODE_ENV=development
EXPOSE 8000
CMD ["bun", "run", "dev"]
