    {
      "title": "Error logs",
      "description": "api lines with level error or fatal, newest first. Expand a line to see request_id and trace_id and jump to the trace.",
      "type": "logs",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "editorMode": "code",
          "expr": "{service=\"api\",level=~\"error|fatal\"}",
          "legendFormat": "__auto",
          "queryType": "range",
          "refId": "A",
          "maxLines": 500
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "id": 8,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "id": 9,
      "panels": [],
      "title": "Request and trace correlation",
      "type": "row"
    },
    {
      "title": "Logs for request_id / trace_id",
      "description": "Lines matching the request_id and trace_id variables (regex; both default to everything). Paste a trace id from Tempo or an x-request-id response header.",
      "type": "logs",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "editorMode": "code",
          "expr": "{service=\"api\", level=~\"$level\"} | request_id=~\"$request_id\" | trace_id=~\"$trace_id\" |~ \"$search\"",
          "legendFormat": "__auto",
          "queryType": "range",
          "refId": "A",
          "maxLines": 500
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "id": 10,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 29
      }
    },
    {
      "title": "Jump to traces",
      "description": "How to go from a log line to its trace.",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "Expand a log line and click **View trace in Tempo** (derived field on `trace_id`), or copy the id into the `trace_id` variable of the [Traces dashboard](/d/tm-traces)."
      },
      "transparent": true,
      "id": 11,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 41
      }
    },
