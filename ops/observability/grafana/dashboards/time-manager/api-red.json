    {
      "title": "Apdex (T=0.25s)",
      "description": "Apdex score with a 250 ms satisfied threshold and 1 s tolerated (uses the 0.25 s and 1 s histogram buckets).",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(sum(rate(http_request_duration_seconds_bucket{job=\"api\",route=~\"$route\",method=~\"$method\",le=\"0.25\"}[$__rate_interval])) + sum(rate(http_request_duration_seconds_bucket{job=\"api\",route=~\"$route\",method=~\"$method\",le=\"1\"}[$__rate_interval]))) / 2 / sum(rate(http_request_duration_seconds_count{job=\"api\",route=~\"$route\",method=~\"$method\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
