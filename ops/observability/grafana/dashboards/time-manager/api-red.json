    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "time-manager"
      ],
      "targetBlank": false,
      "title": "Time Manager dashboards",
      "type": "dashboards"
