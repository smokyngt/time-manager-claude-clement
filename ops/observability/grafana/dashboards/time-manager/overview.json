{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Home dashboard: SLOs, traffic, errors and business activity of the Time Manager API.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "time-manager"
      ],
      "targetBlank": false,
      "title": "Time Manager dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "title": "Navigation",
      "description": "Links to the other Time Manager dashboards. The alert rules live under Alerting > Alert rules.",
      "type": "text",
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "**Overview** | [API RED](/d/tm-api-red) | [Business](/d/tm-business) | [Traces](/d/tm-traces) | [Logs](/d/tm-logs) | [PostgreSQL](/d/tm-postgres) | [Runtime](/d/tm-runtime) | [Alerts](/alerting/list)",
        "mode": "markdown"
      },
      "transparent": true,
      "id": 1,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Availability",
      "description": "Share of requests that did not end in a 5xx over the selected range. SLO target 99.5%.",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "1 - (sum(rate(http_request_duration_seconds_count{job=\"api\",status_code=~\"5..\"}[$__range])) or vector(0)) / sum(rate(http_request_duration_seconds_count{job=\"api\"}[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 2
      }
    },
    {
      "title": "p95 latency",
      "description": "95th percentile of API request duration over the selected range. Threshold: warn 500 ms, critical 1 s.",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[$__range])))",
          "legendFormat": "__auto",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
