logging {
  level  = "info"
  format = "logfmt"
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.memory_limiter.default.input]
  }
}

otelcol.processor.memory_limiter "default" {
  check_interval         = "1s"
  limit_percentage       = 80
  spike_limit_percentage = 25

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  timeout             = "5s"
  send_batch_size     = 1024
  send_batch_max_size = 2048

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

prometheus.operator.servicemonitors "all" {
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

prometheus.operator.podmonitors "all" {
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

prometheus.exporter.blackbox "probes" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s, http: { method: GET, valid_status_codes: [200], preferred_ip_protocol: ip4, tls_config: { insecure_skip_verify: true } } } } }"

  target {
    name    = "api-readiness"
    address = "${api_scheme}://time-manager-api.${app_namespace}.svc.cluster.local:8000/health/ready"
    module  = "http_2xx"
  }

  target {
    name    = "api-liveness"
    address = "${api_scheme}://time-manager-api.${app_namespace}.svc.cluster.local:8000/health"
    module  = "http_2xx"
  }

  target {
    name    = "web"
    address = "http://time-manager-web.${app_namespace}.svc.cluster.local:8080/healthz"
    module  = "http_2xx"
  }
}

prometheus.scrape "probes" {
  job_name        = "probes"
  targets         = prometheus.exporter.blackbox.probes.targets
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy" {
  job_name        = "alloy"
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

prometheus.scrape "tempo" {
  job_name        = "tempo"
  targets         = [{"__address__" = "tempo:3200", "instance" = "tempo"}]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

prometheus.scrape "loki" {
  job_name        = "loki"
  targets         = [{"__address__" = "loki:3100", "instance" = "loki"}]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

prometheus.scrape "prometheus" {
  job_name        = "prometheus"
  targets         = [{"__address__" = "prometheus:9090", "instance" = "prometheus"}]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

prometheus.scrape "alertmanager" {
  job_name        = "alertmanager"
  targets         = [{"__address__" = "alertmanager:9093", "instance" = "alertmanager"}]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

prometheus.scrape "grafana" {
  job_name        = "grafana"
  targets         = [{"__address__" = "grafana:3000", "instance" = "grafana"}]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

discovery.kubernetes "pods" {
  role = "pod"

  namespaces {
    names = [${log_namespaces}]
  }
}

discovery.relabel "logs" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_component"]
    regex         = "(.+)"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.logs.output
  forward_to = [loki.process.pipeline.receiver]
}

loki.process "pipeline" {
  forward_to = [loki.write.loki.receiver]

  stage.match {
    selector = "{service=\"api\"}"

    stage.json {
      expressions = {
        level      = "level",
        request_id = "request_id",
        trace_id   = "trace_id",
      }
    }

    stage.template {
      source   = "level"
      template = `{{ $v := printf "%v" .Value }}{{ if eq $v "10" }}trace{{ else if eq $v "20" }}debug{{ else if eq $v "30" }}info{{ else if eq $v "40" }}warn{{ else if eq $v "50" }}error{{ else if eq $v "60" }}fatal{{ else if or (eq $v "<nil>") (eq $v "") }}unknown{{ else if eq $v "warning" }}warn{{ else }}{{ ToLower $v }}{{ end }}`
    }

    stage.labels {
      values = {
        level = "",
      }
    }

    stage.structured_metadata {
      values = {
        request_id = "",
        trace_id   = "",
      }
    }
  }

  stage.match {
    selector = "{service!=\"api\"}"

    stage.static_labels {
      values = {
        level = "unknown",
      }
    }
  }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
